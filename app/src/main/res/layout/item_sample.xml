<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:strokeColor="#C2D6C5"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header: Sample ID & Variety Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvSampleId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="RICE-2026-001"
                android:textColor="#1B4D2E"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvVarietyBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#E8F5E9"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="IR64"
                android:textColor="#2E7D32"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Date & Location -->
        <TextView
            android:id="@+id/tvDateLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="📅 2026-11-17 14:30 | 📍 Lat: 17.3850, Lon: 78.4867"
            android:textColor="#526653"
            android:textSize="13sp"/>

        <!-- Weather Summary -->
        <TextView
            android:id="@+id/tvWeatherSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🌤️ 28.5°C | 💧 65% Humidity | 🌧️ 0.0mm"
            android:textColor="#388E3C"
            android:textSize="13sp"/>

        <!-- BioKT Analysis Summary -->
        <TextView
            android:id="@+id/tvGenomicSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🧬 Seq: 2350 bp | GC: 48.2% | Cis-Elements: 8 | SSRs: 4"
            android:textColor="#1B4D2E"
            android:textSize="13sp"/>

        <!-- Action Buttons: View/Edit & Delete -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditSample"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="✏️ Edit"
                android:textSize="12sp"
                android:textColor="#2E7D32"
                app:strokeColor="#2E7D32"
                app:cornerRadius="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteSample"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:text="🗑️ Delete"
                android:textSize="12sp"
                android:textColor="#D32F2F"/>
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
